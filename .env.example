# Copy only missing, non-secret settings into .env. Never commit .env.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
SQLITE_PATH=data/meme_quant.db
DRY_RUN=true
SIMULATION_ENABLED=true
TRADING_PROVIDER=gmgn_cli
GMGN_CLI_PATH=gmgn-cli

# Live trading remains disabled until the two-click confirmation succeeds.
LIVE_CONFIRMATION_TTL_SECONDS=60
WALLET_SOL_RESERVE=0.1
MAX_OPEN_POSITIONS=10
MAX_DAILY_LOSS_FRACTION=0.20
CONSECUTIVE_LOSS_LIMIT=5

# Model lifecycle
TRAINING_TIMEZONE=Asia/Shanghai
TRAINING_WEEKDAY=6
TRAINING_HOUR=3
TRAINING_MINUTE=0
TRAINING_LOOKBACK_DAYS=120
TRAINING_HOLDOUT_DAYS=30
MIN_PRECISION=0.20
PROMOTION_MIN_PNL_LIFT=0.05

# Conservative versioned execution ladder. Fractions: 0.10 = 10% slippage.
# The default anti-MEV priority starts at the official 0.002 SOL minimum;
# priority+tip never exceeds 0.006 SOL.
TRADE_SLIPPAGE_LOW=0.10
TRADE_SLIPPAGE_MEDIUM=0.15
TRADE_SLIPPAGE_HIGH=0.25
TRADE_PRIORITY_FEE_LOW_SOL=0.002
TRADE_PRIORITY_FEE_MEDIUM_SOL=0.003
TRADE_PRIORITY_FEE_HIGH_SOL=0.005
TRADE_TIP_FEE_LOW_SOL=0.0001
TRADE_TIP_FEE_MEDIUM_SOL=0.0005
TRADE_TIP_FEE_HIGH_SOL=0.001
TRADE_TOTAL_FEE_CAP_SOL=0.006

# Existing credentials stay in .env. Do not add real values here.
GMGN_API_BASE_URL=
GMGN_API_KEY_1=
GMGN_API_KEY_2=
GMGN_API_KEY_3=
GMGN_API_KEY_4=
GMGN_API_KEY_5=
GMGN_API_KEY_6=
GMGN_API_KEY_7=
GMGN_API_KEY_8=
GMGN_API_KEY_9=
GMGN_API_KEY_10=
GMGN_API_KEY_11=
GMGN_API_KEY_12=
GMGN_PRIVATE_KEY_1=
WALLET_PUBLIC_KEY=
WALLET_PRIVATE_KEY_BASE58=
